# Copy to .env (git-ignored) or export in your shell. Names only; never commit values.

# Where Radar keeps its SQLite database and receipts (default: var/radar)
RADAR_DATA_DIR=

# Override the HTTP User-Agent sent to public sources.
# Default: Radar/<version> (+https://github.com/boowenchen/zh-community-radar)
RADAR_USER_AGENT=

# Optional path to the Claude Code CLI when provider is claude_cli
RADAR_CLAUDE_EXECUTABLE=

# API key for the openai_compatible provider. The variable NAME is set in
# config/model.local.json -> http.api_key_env; this is the default example name.
RADAR_LLM_API_KEY=
